{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @amarid/id",
    "watchPatterns": ["apps/id/**", "docs/**", "README.md", "package.json", "package-lock.json"]
  },
  "deploy": {
    "preDeployCommand": ["npm run setup"],
    "startCommand": "npm run start -w @amarid/id",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
