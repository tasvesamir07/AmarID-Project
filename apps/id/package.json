{
  "name": "@amarid/id",
  "private": true,
  "version": "2.0.0",
  "description": "AmarID identity provider and citizen wallet",
  "scripts": {
    "predev": "node scripts/copy-models.mjs && node scripts/build-docs-index.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/copy-models.mjs && node scripts/build-docs-index.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/universal-id.test.ts src/server/biometrics/template.test.ts src/server/mcp/search.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "tsx --env-file=../../.env --test tests/e2e.test.ts",
    "pretypecheck": "node scripts/build-docs-index.mjs",
    "pretest": "node scripts/build-docs-index.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@vladmandic/human": "^3.3.6",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3"
  }
}
