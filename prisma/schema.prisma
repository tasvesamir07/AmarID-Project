// AmarID Prisma schema
// Data model from 02-BACKEND-ARCHITECTURE.md
// snake_case, UUID v7 PKs (stored as UUID), created_at/updated_at

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  PENDING
  ACTIVE
  DORMANT
  SUSPENDED
  REVOKED
  DECEASED
}

enum EnrollmentState {
  STARTED
  DOC_VERIFIED
  SIM_VERIFIED
  EMAIL_VERIFIED
  LIVENESS_PADDED
  LIVENESS_PASSED
  FINGERPRINT_CAPTURED
  DEDUP_CHECKED
  ISSUED
  REJECTED_DUPLICATE
  REJECTED_DOC
  REJECTED_LIVENESS
  EXPIRED
}

enum BiometricModality {
  FACE
  FINGER
}

enum AssuranceLevel {
  LOA1
  LOA2
  LOA3
}

enum OtpPurpose {
  SIGNUP_SIM
  SIGNUP_EMAIL
  STEP_UP
  RECOVERY
  CHANGE_CONTACT
}

enum OtpChannel {
  SMS
  EMAIL
}

enum EkycLevel {
  BASIC
  STANDARD
  ENHANCED
}

enum EkycStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum ProofOfLifeResult {
  PASS
  FAIL
  SKIPPED
}

model Identity {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universalId          String         @unique @db.VarChar(24)
  docHmac              String         @unique @db.VarChar(128)
  status               IdentityStatus @default(PENDING)
  assuranceLevel       AssuranceLevel @default(LOA1)
  issuedAt             DateTime?
  lastProofOfLifeAt    DateTime?
  nextProofOfLifeDueAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  bioTemplates      BioTemplate[]
  simBindings       SimBinding[]
  contacts          Contact[]
  devices           Device[]
  enrollments       Enrollment[]
  consents          Consent[]
  pairwiseSubjects  PairwiseSubject[]
  ekycRequests      EkycRequest[]
  proofOfLifeEvents ProofOfLifeEvent[]

  @@index([status])
  @@index([docHmac])
  @@index([universalId])
}

model BioTemplate {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity      Identity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId    String            @db.Uuid
  modality      BiometricModality
  protectedBlob Bytes // AES-256-GCM encrypted protected template
  keyVersion    Int               @default(1)
  createdAt     DateTime          @default(now())

  @@index([identityId, modality])
}

model SimBinding {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String    @db.Uuid
  msisdnHmac String    @db.VarChar(128)
  msisdnEnc  Bytes // encrypted value for notifications
  verifiedAt DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@index([msisdnHmac])
  @@index([active])
}

model Contact {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String    @db.Uuid
  emailHmac  String    @db.VarChar(128)
  emailEnc   Bytes // encrypted
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@index([emailHmac])
}

model Device {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity             Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId           String    @db.Uuid
  webauthnCredentialId String    @db.VarChar(255)
  publicKeyPem         String    @db.Text
  signCount            Int       @default(0)
  transports           String?   @db.Text
  label                String    @db.VarChar(100)
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([identityId])
  @@index([webauthnCredentialId])
}

model Enrollment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity              Identity?       @relation(fields: [identityId], references: [id], onDelete: SetNull)
  identityId            String?         @db.Uuid
  state                 EnrollmentState @default(STARTED)
  clientFingerprintHash String          @db.VarChar(128)
  expiresAt             DateTime
  docHmac               String?         @db.VarChar(128)
  msisdnHmac            String?         @db.VarChar(128)
  emailHmac             String?         @db.VarChar(128)
  livenessScore         Float?
  docVerifiedAt         DateTime?
  simVerifiedAt         DateTime?
  livenessPassedAt      DateTime?
  fingerprintCapturedAt DateTime?
  dedupCheckedAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([state])
  @@index([expiresAt])
  @@index([clientFingerprintHash])
}

model OidcClient {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String   @unique @db.VarChar(100)
  name             String   @db.VarChar(200)
  secretHash       String?  @db.VarChar(255)
  redirectUris     String[]
  scopes           String[]
  type             String   @db.VarChar(20) // confidential | public
  sectorIdentifier String?  @db.VarChar(255)
  verifiedPartner  Boolean  @default(false)
  tier             String   @default("sandbox") @db.VarChar(20)
  createdAt        DateTime @default(now())

  consents    Consent[]
  EkycRequest EkycRequest[]

  @@index([clientId])
  @@index([verifiedPartner])
}

model Consent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity   Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String     @db.Uuid
  client     OidcClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String     @db.Uuid
  scopes     String[]
  grantedAt  DateTime   @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([identityId])
  @@index([clientId])
  @@index([revokedAt])
}

model PairwiseSubject {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId   String   @db.Uuid
  clientSector String   @db.VarChar(255)
  subject      String   @unique @db.VarChar(255) // pairwise pseudonymous sub
  createdAt    DateTime @default(now())

  @@index([identityId])
  @@index([clientSector])
  @@index([subject])
}

model EkycRequest {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client         OidcClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String     @db.Uuid
  identity       Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId     String     @db.Uuid
  level          EkycLevel
  status         EkycStatus @default(PENDING)
  attestationJws String?
  expiresAt      DateTime
  createdAt      DateTime   @default(now())

  @@index([clientId])
  @@index([identityId])
  @@index([status])
}

model ProofOfLifeEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identity    Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId  String             @db.Uuid
  dueAt       DateTime
  completedAt DateTime?
  method      String?            @db.VarChar(100)
  result      ProofOfLifeResult?
  scoreBucket String?            @db.VarChar(50)
  createdAt   DateTime           @default(now())

  @@index([identityId])
  @@index([dueAt])
  @@index([result])
}

model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor            String?  @db.VarChar(255) // pseudonymous actor id
  action           String   @db.VarChar(100)
  subjectPseudonym String?  @db.VarChar(255)
  metadata         Json
  prevHash         String   @db.VarChar(128)
  hash             String   @db.VarChar(128)
  createdAt        DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([subjectPseudonym])
}
