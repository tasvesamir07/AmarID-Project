# =============================================================================
# AmarID environment configuration
# Copy this file to .env and adjust values. Never commit .env.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
RP_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://amarid:amarid_dev_password@localhost:5432/amarid?schema=public"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security (generate strong random values in production) ---
# KMS master key (dev uses local file KMS — flagged non-production)
KMS_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Pepper for NID/SIM HMAC uniqueness keys
PEPPER_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# JWT signing (ES256/EdDSA) — generate a real keypair for production
JWT_PRIVATE_KEY_PEM_PATH=./config/dev-jwt-private.pem
JWT_PUBLIC_KEY_PEM_PATH=./config/dev-jwt-public.pem
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_MAX_AGE_DAYS=30
JWT_REFRESH_HARD_MAX_DAYS=90

# --- OIDC Provider ---
OIDC_ISSUER=http://localhost:4000
OIDC_ACCESS_TTL_SECONDS=600
OIDC_ID_TOKEN_TTL_SECONDS=900

# --- Encryption (envelope encryption DEK) ---
ENC_DEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- OTP (from 03-AUTH-OTP-EMAIL.md) ---
OTP_SMS_TTL_SECONDS=300
OTP_EMAIL_TTL_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_DEV_MODE=true

# --- Email (Nodemailer SMTP -> Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AmarID <noreply@amarid.local>"
MAIL_FROM_NAME=AmarID

# --- SMS (pluggable gateway — ConsoleSmsGateway in dev) ---
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=...

# --- Adapters (all mocked for offline demo) ---
NID_PROVIDER=mock
SIM_REGISTRY=mock
LIVENESS_PROVIDER=mock
FINGERPRINT_PROVIDER=mock
DECEASED_REGISTRY=mock

# --- Demo scenarios (triggers mock adapter outcomes: success|mismatch|timeout|duplicate) ---
DEMO_SCENARIO=success

# --- Proof-of-life ---
PROOF_OF_LIFE_DEFAULT_CYCLE_DAYS=365
PROOF_OF_LIFE_REMINDER_DAYS=60,30,7
PROOF_OF_LIFE_GRACE_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=20

# --- Webhooks ---
WEBHOOK_SECRET=dev_webhook_secret_do_not_use_in_prod

# --- Feature flags ---
FEATURE_GUIDED_DEMO=true
FEATURE_PWA=true
