# `npm run dev` creates .env from this file with fresh random secrets.

# Public origin of the identity provider. It is also the OIDC issuer and the
# WebAuthn relying-party origin, so it must be exactly what the browser sees.
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://amarid:amarid@localhost:54329/amarid_dev

# 32 random bytes, hex. Every other key (sealing, blind indexes, template
# transform, pairwise subjects) is derived from it with HKDF. Losing it makes
# stored data unreadable; leaking it voids the privacy guarantees.
AMARID_MASTER_KEY=

# true  = external systems (NID registry, SIM registry, SMS) are simulated and
#         the sandbox tools are visible in the UI.
# false = sandbox adapters refuse to run. Real adapters must be wired first.
SANDBOX=true

# Operator console password (/admin).
ADMIN_TOKEN=

# Demo partners (apps/partners)
PARTNERS_URL=http://localhost:3001
BAZAR_CLIENT_SECRET=
BANK_CLIENT_SECRET=
PARTNERS_SESSION_SECRET=
