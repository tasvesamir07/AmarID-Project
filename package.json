{
  "name": "amarid",
  "private": true,
  "version": "2.0.0",
  "description": "AmarID — a privacy-first universal digital identity for Bangladesh",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "db": "node scripts/dev-db.mjs",
    "db:migrate": "npm run db:migrate -w @amarid/id",
    "db:seed": "npm run db:seed -w @amarid/id",
    "setup": "npm run db:migrate && npm run db:seed",
    "dev": "node scripts/dev.mjs",
    "dev:id": "npm run dev -w @amarid/id",
    "dev:partners": "npm run dev -w @amarid/partners",
    "build": "npm run build -w @amarid/id && npm run build -w @amarid/partners",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @amarid/id",
    "test:e2e": "npm run test:e2e -w @amarid/id",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "17.12.0-beta.19"
  }
}
